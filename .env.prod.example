# Database Configuration
POSTGRES_DB=richboy_prod
POSTGRES_USER=richboy_user
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# Django Configuration
SECRET_KEY=your_very_long_and_secure_secret_key_here
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com,your-oracle-ip
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://your-domain.com

# SSL Certificate Configuration
# Set to 'true' to use Let's Encrypt, 'false' to use your own certificates
USE_LETSENCRYPT=true

# Let's Encrypt Email
LETS_ENCRYPT_EMAIL=your-email@example.com

# Domain Configuration
DOMAIN_NAME=your-domain.com